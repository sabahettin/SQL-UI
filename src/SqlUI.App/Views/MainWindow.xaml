<Window x:Class="SqlUI.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:vm="clr-namespace:SqlUI.App.ViewModels"
        xmlns:services="clr-namespace:SqlUI.App.Services"
        Title="{Binding WindowTitle}" Height="750" Width="1300" MinWidth="640" MinHeight="420"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackground}"
        TextElement.Foreground="{DynamicResource AppForeground}"
        FontFamily="{Binding Source={x:Static services:EditorSettings.Instance}, Path=FontFamily}">

    <Window.Resources>
        <!-- Segoe Fluent Icons (Win11) / Segoe MDL2 Assets (Win10) glyph fontu. Kod noktalari
             GlyphTypeface.CharacterToGlyphMap ile dogrulandi, tofu kutucuk riski yok. -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="MenuIconGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ExecuteCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewQueryCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenQueryFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveQueryCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveQueryAsCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ShowEstimatedPlanCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Arac cubugu: her buton bir ikon (Segoe Fluent Icons) + metin iceriyor -->
        <ToolBar DockPanel.Dock="Top" Style="{StaticResource ThemedToolBarStyle}">
            <Button Command="{Binding NewQueryCommand}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewQuery]}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenQueryFileCommand}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Open]}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveQueryCommand}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Save]}"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ExecuteCommand}" Padding="8,4" FontWeight="Bold">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" Foreground="ForestGreen"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Execute]}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelQueryCommand}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;" Style="{StaticResource IconGlyph}" Foreground="Crimson"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Cancel]}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ShowEstimatedPlanCommand}" Padding="8,4"
                    Visibility="{Binding SupportsExecutionPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA37;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ExecutionPlan]}"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[DatabaseLabel]}" VerticalAlignment="Center" Margin="6,0"
                       Visibility="{Binding SupportsMultipleDatabases, Converter={StaticResource BoolToVis}}"/>
            <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" Width="160"
                      Visibility="{Binding SupportsMultipleDatabases, Converter={StaticResource BoolToVis}}"/>
            <Separator/>
            <Button Click="NewDatabase_Click" Padding="8,4"
                    Visibility="{Binding SupportsDatabaseManagement, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9AC;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewDatabase]}"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ToggleThemeCommand}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE706;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Theme]}"/>
                </StackPanel>
            </Button>
            <Button Click="Settings_Click" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings]}"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Durum cubugu: sol tarafta durum metni, sag tarafta satir sayisi + sure.
             Varsayilan StatusBar paneli sag-hizalamayi guvenilir yapmadigi icin DockPanel'e geciyoruz. -->
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource ThemedStatusBarStyle}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Content="{Binding StatusText}" DockPanel.Dock="Left"/>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RowCountText}" Margin="0,0,16,0"/>
                    <Separator/>
                    <TextBlock Text="{Binding ElapsedText}" Margin="16,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Object Explorer: baslik cubuklu bir "panel" gorunumu - ciplak bir TreeView yerine
                 SSMS'teki gibi tanimli bir sinir/baslik veriyor. TreeView'in Background/Foreground'u
                 burada ACIKCA veriliyor (ThemeMode'un varsayilanina birakilmiyor) ki koyu temada
                 rengin tutarsiz/kararsiz kalmamasi garanti olsun. -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                <DockPanel Background="{DynamicResource AppControlBackground}">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppGridHeaderBackground}"
                            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AppForeground}"/>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ObjectExplorer]}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="ObjectExplorerTree" ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="ObjectExplorerTree_SelectedItemChanged"
                              Background="{DynamicResource AppControlBackground}" Foreground="{DynamicResource AppForeground}"
                              BorderThickness="0" Padding="4"
                              MouseDoubleClick="ObjectExplorerTree_MouseDoubleClick"
                              PreviewMouseRightButtonDown="ObjectExplorerTree_PreviewMouseRightButtonDown">
                <TreeView.Resources>
                    <ContextMenu x:Key="DatabaseContextMenu">
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewQuery]}" Click="MenuNewQuery_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Tasks]}">
                            <MenuItem.Icon><TextBlock Text="&#xE712;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                            <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Backup]}" Click="MenuBackupDatabase_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE74E;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Restore]}" Click="MenuRestoreDatabase_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE895;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[RenameMenu]}" Click="MenuRenameDatabase_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Delete]}" Click="MenuDeleteDatabase_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource MenuIconGlyph}" Foreground="Crimson"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Refresh]}" Click="MenuRefreshNode_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                    <ContextMenu x:Key="TableContextMenu">
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SelectTop1000]}" Click="MenuSelectTop1000_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE890;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ScriptTableAs]}">
                            <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                            <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ScriptCreate]}" Click="MenuScriptCreate_Click"/>
                            <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ScriptSelect]}" Click="MenuScriptSelect_Click"/>
                            <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ScriptInsert]}" Click="MenuScriptInsert_Click"/>
                            <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ScriptDrop]}" Click="MenuScriptDrop_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Delete]}" Click="MenuDeleteTable_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource MenuIconGlyph}" Foreground="Crimson"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Refresh]}" Click="MenuRefreshNode_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                    <ContextMenu x:Key="StoredProcedureContextMenu">
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ModifySp]}" Click="MenuModifySp_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ExecuteSp]}" Click="MenuExecuteSp_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuIconGlyph}" Foreground="ForestGreen"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Delete]}" Click="MenuDeleteSp_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource MenuIconGlyph}" Foreground="Crimson"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Refresh]}" Click="MenuRefreshNode_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                    <ContextMenu x:Key="FolderContextMenu">
                        <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Refresh]}" Click="MenuRefreshNode_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuIconGlyph}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <!-- Varsayilan TreeViewItem sablonu secim/hover renklerini sistem accent
                         renginden alir ve koyu temada tutarsiz gorunebilir; bunun yerine
                         temaya (AppHoverBackground/AppSelectedBackground) bagli, yuvarlatilmis
                         bir satir vurgusu olan ozel bir sablon veriyoruz. -->
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="2,3"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="RowBorder" Background="Transparent" CornerRadius="4" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton x:Name="Expander" Grid.Column="0" Focusable="False" Width="16" Height="16"
                                                              ClickMode="Press" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="ArrowBg" Background="Transparent" CornerRadius="8" Width="16" Height="16">
                                                                <Path x:Name="Arrow" Data="M0,0 L8,4 L0,8 Z" Fill="{DynamicResource AppAccent}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Data" Value="M0,0 L8,0 L4,7 Z"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ArrowBg" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AppSelectedBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Database">
                                <Setter Property="ContextMenu" Value="{StaticResource DatabaseContextMenu}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Table">
                                <Setter Property="ContextMenu" Value="{StaticResource TableContextMenu}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="View">
                                <Setter Property="ContextMenu" Value="{StaticResource TableContextMenu}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="StoredProcedure">
                                <Setter Property="ContextMenu" Value="{StaticResource StoredProcedureContextMenu}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyph}" FontSize="14" Width="18" Foreground="{Binding IconColor}"/>
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Sorgu sekmeleri -->
            <TabControl Grid.Column="2" x:Name="QueryTabControl" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.ContextMenu>
                                <!-- ContextMenu ayri bir gorsel agactadir, DataContext'i normalde kalitilmaz;
                                     PlacementTarget uzerinden elle baglayip Click handler'lariyla (code-behind)
                                     yonetiyoruz - Object Explorer menulerindeki pattern ile tutarli. -->
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SaveMenu]}" Click="TabMenuSave_Click"/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SaveAsMenu]}" Click="TabMenuSaveAs_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CloseMenu]}" Click="TabMenuClose_Click"/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CloseOthersMenu]}" Click="TabMenuCloseOthers_Click"/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CloseAllMenu]}" Click="TabMenuCloseAll_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
                            <Button Content="x" Margin="8,0,0,0" Padding="2,0" BorderThickness="0" Background="Transparent"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <ae:TextEditor x:Name="Editor" Grid.Row="0"
                                           FontFamily="{Binding Source={x:Static services:EditorSettings.Instance}, Path=FontFamily}"
                                           FontSize="{Binding Source={x:Static services:EditorSettings.Instance}, Path=FontSize}"
                                           ShowLineNumbers="True"
                                           Loaded="Editor_Loaded"/>

                            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>

                            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedResultsTabIndex}">
                                <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Results]}">
                                    <ItemsControl ItemsSource="{Binding ResultSets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultSetViewModel}">
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding RowCount, StringFormat='{}{0} satir'}" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="Gray"/>
                                                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ExportToExcel]}" Padding="6,1"
                                                                Command="{Binding DataContext.ExportToExcelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="True"
                                                              IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                                                              CanUserAddRows="False"
                                                              AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </TabItem>
                                <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Messages]}">
                                    <TextBox Text="{Binding MessagesText, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                </TabItem>
                                <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ExecutionPlanTab]}">
                                    <TreeView ItemsSource="{Binding ExecutionPlan}">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
