<!--
    WPF'in deneysel Application.ThemeMode ("evaluation-only", WPF0001) API'si gercek testte
    guvenilir bulunmadi: temayi Dark'a ayarlasak bile pencere/toolbar/tab/grid gibi bir cok
    kontrol beyaz/varsayilan kalmaya devam etti (kullanicinin defalarca bildirdigi "koyu temada
    beyaz kalan alanlar" sorununun kok nedeni buydu). Bunun yerine burada TUM native kontroller
    icin ACIK, TargetType bazli (implicit) Style'lar tanimliyoruz; hepsi DynamicResource ile
    Themes/LightTheme.xaml veya DarkTheme.xaml'daki renk anahtarlarina bagli, boylece
    ThemeService o sozlugu degistirdiginde her kontrol otomatik ve garanti sekilde guncellenir.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Not: Window icin implicit TargetType Style burada TUTULMUYOR - pratikte Window
         ornekleri bu implicit stili guvenilir sekilde almiyor (test edildi). Bunun yerine her
         pencerenin kok XAML etiketinde Background/TextElement.Foreground DOGRUDAN
         DynamicResource ile ayarlaniyor (bkz. MainWindow.xaml, ConnectionDialog.xaml, vb.). -->

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="2,0,0,4"
                                          TextElement.FontWeight="SemiBold"/>
                        <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="2">
                            <ContentPresenter/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{DynamicResource AppInputBackground}">
                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="6,3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelectedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
    </Style>

    <!-- Toolbar: Aero2'nin varsayilan ToolBar sablonu Background setter'ini gormezden gelip
         kendi gradient sistem renklerini kullanir (Button'da gordugumuz sorunun ayni turu) -
         bu yuzden burada da acik bir ControlTemplate veriyoruz. Not: implicit (TargetType-
         bazli) uygulama, MainWindow.xaml'de dogrudan XAML agacinda tanimli (bir DataTemplate
         icinde uretilmeyen) ToolBar/StatusBar gibi kok-seviye kontrollerde guvenilmez cikti
         (Window'da yasanan sorunun ayni turu) - bu yuzden x:Key veriyoruz ve MainWindow.xaml'de
         Style="{StaticResource ...}" ile ACIKCA basvuruyoruz. -->
    <Style TargetType="{x:Type ToolBarTray}">
        <Setter Property="Background" Value="{DynamicResource AppToolBarBackground}"/>
    </Style>
    <Style x:Key="ThemedToolBarStyle" TargetType="{x:Type ToolBar}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolBar}">
                    <!-- Border'in Background/BorderBrush'i BILEREK TemplateBinding degil DOGRUDAN
                         DynamicResource kullanir: {TemplateBinding Background} ile disaridaki
                         Style Setter'inin DynamicResource degerini rolelemek, gercek uygulamada
                         (headless test degil) canli tema degisimini yansitmiyordu - toolbar koyu
                         temada beyaz kalmaya devam ediyordu. Hardcoded "Red" ile yapilan bir
                         testte Border'in DOGRU render edildigi (kirmizi gorundugu) dogrulandi;
                         demek ki sorun tam olarak TemplateBinding+DynamicResource rolesindeydi. -->
                    <!-- IsItemsHost'u WPF'in kendi ToolBarPanel'i yerine bir WrapPanel'e veriyoruz:
                         ToolBarPanel sigmayan ogeleri "tasma" (overflow) menusune atar, ama bizim
                         sade sablonumuzda o menu/dugme yok - sonuc, pencere daraldiginda butonlarin
                         gorunmez (erisilemez) olmasiydi. WrapPanel bunun yerine sigmayan butonlari
                         ALT SATIRA kaydirir - hicbir buton kaybolmaz, best-practice responsive
                         davranis budur. -->
                    <Border Background="{DynamicResource AppToolBarBackground}"
                            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
                        <!-- ToolBar'in kendi PART_ToolBarPanel adi, framework tarafindan sabit
                             "ToolBarPanel" turunde olmaya zorlaniyor (TemplatePart sozlesmesi) -
                             bu yuzden farkli bir isim kullanip WrapPanel'i buraya koyabiliyoruz. -->
                        <WrapPanel x:Name="ItemsWrapPanel" Orientation="Horizontal" IsItemsHost="True" Margin="4,3"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: sade, temaya bagli bir Border tabanli sablona geciyoruz cunku varsayilan Aero2
         sablonu duz Background/BorderBrush setter'larini gormezden gelip sistem renklerini kullanir. -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- Bilerek {TemplateBinding Background} degil dogrudan DynamicResource -
                         bkz. ToolBar'daki not (TemplateBinding+DynamicResource rolesi canli tema
                         degisiminde calismiyordu). -->
                    <Border x:Name="Bd" Background="{DynamicResource AppButtonBackground}"
                            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelectedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox / PasswordBox -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource AppInputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AppSelectedBackground}"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource AppInputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}"/>
    </Style>

    <!-- ComboBox: varsayilan sablon karmasik oldugu icin sade, temaya bagli bir sablon veriyoruz. -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="{DynamicResource AppControlBackground}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelectedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1" CornerRadius="3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Focusable="True"
                                     Margin="{TemplateBinding Padding}" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="1" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <Path Data="M0,0 L7,0 L3.5,5 Z" Fill="{DynamicResource AppForeground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource AppControlBackground}" BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    MaxHeight="300" CornerRadius="3">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl / TabItem -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource AppWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd" Background="{DynamicResource AppTabBackground}" BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1,1,1,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppTabSelectedBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StatusBar (x:Key'li - bkz. ToolBar'daki not) -->
    <Style x:Key="ThemedStatusBarStyle" TargetType="{x:Type StatusBar}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type StatusBar}">
                    <Border Background="{DynamicResource AppGridHeaderBackground}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type StatusBarItem}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <!-- TreeView (genel govde; Object Explorer'daki ogeler kendi ItemContainerStyle'inda ayrica ozellestirilir) -->
    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource AppControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <!-- DataGrid (sonuc grid'leri) -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource AppControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="RowBackground" Value="{DynamicResource AppControlBackground}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource AppGridHeaderBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border Background="{DynamicResource AppGridHeaderBackground}" BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppSelectedBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Menu / ContextMenu -->
    <!-- Aero2'nin menu sablonu ikon kolonu ve ayiriclari sistem renkleriyle (beyaz) ciziyordu;
         tamamen temaya bagli sablonlar veriyoruz. -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource AppControlBackground}" BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1" Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="6,3" Background="{DynamicResource AppBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="4,5" Margin="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="6,0,16,0"/>
                            <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource AppForeground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource AppControlBackground}" BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1" Padding="2">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer icindeki bos alan (ornegin ComboBox popup govdesi) -->
    <!-- ScrollViewer: varsayilan sablonun sag-alt kose karesi SystemColors.ControlBrushKey
         kullanir; bunu SADECE DarkTheme.xaml icinde override etmek (LightTheme.xaml'da yok)
         tema degistirmede tuhaf/kararsiz sonuclara yol acti (SystemColors anahtarlarinin
         DynamicResource gecersiz kilma/geri donus semantigi normal anahtarlardan farkli
         davraniyor). Bunun yerine kose karesini KENDI temali sablonumuzda ciziyoruz. -->
    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource AppScrollTrack}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolBar, icindeki Button/ComboBox/Separator'lara implicit stil yerine KENDI anahtarli
         stillerini (ToolBar.ButtonStyleKey vb.) uygular; bu yuzden toolbar'daki ComboBox beyaz
         kaliyordu. Bu anahtarlari bizim stillerimize yonlendiriyoruz. -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="1,0"/>
    </Style>
    <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}"/>
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Width="1" Margin="6,4" Background="{DynamicResource AppBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{DynamicResource AppControlBackground}" BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1" Padding="6,3">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="{DynamicResource AppBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar (editor, grid, agac) - varsayilan Aero2 kaydirma cubugu koyu temada beyaz kaliyordu. -->
    <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd" Background="{DynamicResource AppScrollThumb}" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{DynamicResource AppScrollTrack}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{DynamicResource AppScrollTrack}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
